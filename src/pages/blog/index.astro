---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import styles from '../../styles/blog-index.module.css'

const posts = await getCollection('blog')
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

// Descriptions come from Markdown frontmatter and may contain link syntax.
function plainText(markdown: string): string {
  return markdown.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
}
---

<Layout title="All posts">
  {posts.map((post) => (
    <article class={styles.postItem}>
      <header>
        <h2 class={styles.postTitle}>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h2>
        <time class={styles.date} datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </header>
      {post.data.description && (
        <p class={styles.excerpt}>{plainText(post.data.description)}</p>
      )}
    </article>
  ))}
</Layout>
