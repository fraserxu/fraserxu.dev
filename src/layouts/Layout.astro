---
import Nav from '../components/Nav.astro'
import '../styles/global.css'
import styles from '../styles/Layout.module.css'

interface Props {
  title: string
  description?: string
  isHome?: boolean
}

const { title, description = 'Blog.', isHome = false } = Astro.props
const siteTitle = 'Fraser Xu'
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="fraserxu" />
  </head>
  <body>
    <div class={styles.container}>
      <header class={styles.header}>
        {isHome ? (
          <>
            <h1 class={styles.titleLarge}>
              <a href="/">{siteTitle}</a>
            </h1>
            <Nav />
          </>
        ) : (
          <div class={styles.headerInner}>
            <h3 class={styles.titleSmall}>
              <a href="/">{siteTitle}</a>
            </h3>
            <Nav />
          </div>
        )}
      </header>
      <main>
        <slot />
      </main>
      <footer class={styles.footer}>
        &copy; {new Date().getFullYear()}, Built with{' '}
        <a href="https://astro.build">Astro</a>
      </footer>
    </div>
  </body>
</html>
